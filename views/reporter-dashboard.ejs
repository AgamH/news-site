<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> — The Daily Bugle</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="/css/reporter-dashboard.css">
  </head>
  <body class="reporter-dashboard">
    <header class="reporter-header">
      <nav class="reporter-nav" aria-label="Account navigation">
        <a href="/">News feed</a>
        <span>Signed in as <strong><%= currentUser.name %></strong></span>
        <button id="logout" type="button">Log out</button>
      </nav>
      <div class="reporter-heading">
        <p class="reporter-kicker">THE DAILY BUGLE · REPORTER DESK</p>
        <h1>My articles</h1>
        <p>Track drafts, submissions, and published stories.</p>
      </div>
    </header>
    <main class="reporter-main">
      <% if (notice) { %><p class="reporter-notice" role="status"><%= notice %></p><% } %>
      <section class="reporter-tools" aria-labelledby="status-title">
        <div>
          <h2 id="status-title">Your newsroom</h2>
          <nav class="reporter-filters" aria-label="Filter articles by status">
            <a href="/reporter" class="<%= statusFilter === '' ? 'active' : '' %>" <%= statusFilter === '' ? 'aria-current="page"' : '' %>>All <span><%= Object.values(statusCounts).reduce((sum, count) => sum + count, 0) %></span></a>
            <% for (const status of ['draft', 'pending', 'published', 'returned']) { %>
              <a href="/reporter?status=<%= status %>" class="<%= statusFilter === status ? 'active' : '' %>" <%= statusFilter === status ? 'aria-current="page"' : '' %>><%= status[0].toUpperCase() + status.slice(1) %> <span><%= statusCounts[status] %></span></a>
            <% } %>
          </nav>
        </div>
        <a class="new-article" href="/reporter/new">+ New article</a>
      </section>

      <section class="reporter-articles" aria-labelledby="articles-title">
        <div class="reporter-section-heading">
          <h2 id="articles-title"><%= statusFilter ? statusFilter[0].toUpperCase() + statusFilter.slice(1) : 'All' %> articles</h2>
          <span><%= total %> total</span>
        </div>
        <% if (!articles.length) { %>
          <p class="reporter-empty">No articles in this view yet.</p>
        <% } else { %>
          <ul class="reporter-list">
            <% articles.forEach((article) => { %>
              <li class="reporter-row">
                <div class="reporter-row-main">
                  <p class="reporter-category"><%= article.category %></p>
                  <h3><a href="/reporter/<%= article.id %>/edit"><%= article.title %></a></h3>
                  <% if (article.status === 'returned' && article.editorNote) { %>
                    <p class="reporter-note"><strong>Editor's note:</strong> <%= article.editorNote %></p>
                  <% } %>
                </div>
                <dl class="reporter-meta">
                  <div><dt>Status</dt><dd><span class="reporter-status reporter-status--<%= article.status %>"><%= article.status %></span></dd></div>
                  <div><dt>Live</dt><dd><%= article.isLive ? 'Yes' : 'No' %></dd></div>
                  <div><dt>Views</dt><dd><%= article.views %></dd></div>
                  <div><dt>Updated</dt><dd><time datetime="<%= new Date(article.updatedAt).toISOString() %>"><%= new Date(article.updatedAt).toLocaleDateString('en-US') %></time></dd></div>
                </dl>
              </li>
            <% }) %>
          </ul>
          <% if (pages > 1) { %>
            <nav class="reporter-pagination" aria-label="Article pages">
              <% if (page > 1) { %><a href="/reporter?status=<%= statusFilter %>&page=<%= page - 1 %>" rel="prev">Previous</a><% } %>
              <span>Page <%= page %> of <%= pages %></span>
              <% if (page < pages) { %><a href="/reporter?status=<%= statusFilter %>&page=<%= page + 1 %>" rel="next">Next</a><% } %>
            </nav>
          <% } %>
        <% } %>
      </section>
    </main>
    <script src="/js/reporter-dashboard.js" defer></script>
  </body>
</html>