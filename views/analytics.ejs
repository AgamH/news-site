<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> — The Daily Bugle</title>
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="stylesheet" href="/css/newsroom.css" />
  </head>
  <body>
    <header class="compact-header">
      <nav class="account-bar" aria-label="Account">
        <a class="nav-link" href="/editor/<%= articleId %>">← Back to review</a>
        <span>Signed in as <strong><%= currentUser.name %></strong> · editor</span>
        <button id="logout" class="light-button" type="button">Log out</button>
      </nav>
      <p class="eyebrow">THE DAILY BUGLE · ANALYTICS IMPACT</p>
      <h1><%= articleTitle || 'Untitled draft' %></h1>
      <p>Reader views over time, with every approved update marked on the timeline.</p>
    </header>

    <main class="form-main" id="analytics" data-api="/api/editor/articles/<%= articleId %>/analytics" data-range="<%= range %>">
      <section class="analytics-summary" aria-label="Article view summary">
        <div>
          <span>All-time views</span>
          <strong id="analytics-total"><%= totalViews %></strong>
        </div>
        <div>
          <span id="analytics-period-label">Views in range</span>
          <strong id="analytics-period">–</strong>
        </div>
        <div>
          <span>Updates published in range</span>
          <strong id="analytics-updates">–</strong>
        </div>
      </section>

      <nav class="analytics-ranges" aria-label="Time range">
        <% ranges.forEach((item) => { %>
          <button type="button" class="analytics-range" data-range="<%= item.key %>" aria-pressed="<%= item.key === range ? 'true' : 'false' %>"><%= item.label %></button>
        <% }) %>
      </nav>

      <section class="panel analytics-panel" aria-labelledby="analytics-chart-title">
        <div class="analytics-heading">
          <div>
            <p class="eyebrow" id="analytics-range-label"></p>
            <h2 id="analytics-chart-title">Reader views over time</h2>
          </div>
          <ul class="analytics-legend" aria-label="Chart legend">
            <li><span class="legend-line" aria-hidden="true"></span><span id="analytics-legend-views">Views</span></li>
            <li><span class="legend-marker" aria-hidden="true"></span>Update approved &amp; published</li>
          </ul>
        </div>

        <div class="analytics-chart" id="analytics-chart-wrap">
          <canvas id="analytics-chart" tabindex="0" role="img" aria-label="Line chart of reader views over time. The table below lists each update with views before and after."></canvas>
          <div class="analytics-tooltip" id="analytics-tooltip" hidden></div>
        </div>
        <p class="form-message" id="analytics-message" role="status"></p>
        <noscript><p class="empty-state">The chart needs JavaScript to be enabled.</p></noscript>
      </section>

      <section class="panel" aria-labelledby="analytics-impact-title">
        <h2 id="analytics-impact-title">Impact of each update</h2>
        <p class="analytics-note">Views in the 24 hours before each approval compared with the 24 hours after it. For an update less than 24 hours old, both sides use the time elapsed since the update.</p>
        <div class="analytics-table-wrap">
          <table class="analytics-table">
            <thead>
              <tr>
                <th scope="col">Publication</th>
                <th scope="col">Approved at</th>
                <th scope="col">Compared window</th>
                <th scope="col" class="num">Views before</th>
                <th scope="col" class="num">Views after</th>
                <th scope="col" class="num">Change</th>
              </tr>
            </thead>
            <tbody id="analytics-impact"></tbody>
          </table>
        </div>
      </section>
    </main>
    <script src="/js/reporter-dashboard.js" defer></script>
    <script src="/vendor/purify.min.js" defer></script>
    <script src="/js/sanitize.js" defer></script>
    <script src="/js/analytics.js" defer></script>
  </body>
</html>
