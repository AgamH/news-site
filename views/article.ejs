<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %> — The Daily Bugle</title><meta name="description" content="<%= article.summary || '' %>"><link rel="stylesheet" href="/css/styles.css"><link rel="stylesheet" href="/css/home.css"><link rel="stylesheet" href="/css/article.css"></head><body class="article-page-shell"><header class="masthead site-header"><nav class="account-bar" aria-label="Main navigation"><a href="/">← All headlines</a><% if (currentUser) { %><span>Signed in as <strong><%= currentUser.name || currentUser.username || 'Reader' %></strong></span><% if (currentUser.role === 'reporter') { %><a href="/reporter">My articles</a><% } %><% if (currentUser.role === 'editor') { %><a href="/editor">Editor desk</a><a href="/admin/logs">System logs</a><% } %><button id="logout" class="btn btn--quiet" type="button">Log out</button><% } else { %><a href="/login">Newsroom log in</a><% } %></nav><div class="container article-masthead"><p class="eyebrow">THE DAILY BUGLE · SPECIAL REPORT</p><p class="story-category"><%= article.category || 'News' %></p><h1 class="article-title"><%= article.title %></h1><p class="article-summary"><%= article.summary || '' %></p><p class="article-meta">By <strong><%= article.reporterName || 'Daily Bugle Staff' %></strong><span><%= article.publishedAt ? new Date(article.publishedAt).toLocaleDateString('en-US') : '' %></span><span><%= article.views || 0 %> views</span></p></div></header><main class="article-page container"><article class="article-content"><% if (article.imageUrl) { %><img class="article-hero" src="<%= article.imageUrl %>" alt=""><% } %><div class="article-body"><% String(article.content || '').replace(/^\s*<\\\s*/, '').split(/\r?\n/).forEach((paragraph) => { if (paragraph.trim()) { %><p><%= paragraph %></p><% } }); %></div></article><section class="comments" aria-labelledby="comments-title"><h2 id="comments-title">Reader comments <span id="comment-count">(<%= comments.length %>)</span></h2><form id="comment-form" class="comment-form"><div class="field"><label for="comment-name">Name (optional)</label><input id="comment-name" name="authorName" maxlength="60" autocomplete="name" placeholder="Your name"></div><div class="field"><label for="comment-body">Comment</label><textarea id="comment-body" name="body" rows="4" maxlength="2000" required placeholder="Join the conversation…"></textarea></div><button id="comment-submit" class="btn" type="submit">Post comment</button><p id="comment-message" class="form-message" role="status" aria-live="polite"></p></form><p id="comment-empty" class="comment-empty" <%= comments.length ? 'hidden' : '' %>>No comments yet. Be the first to comment.</p><ul id="comment-list" class="comment-list"><% comments.forEach((comment) => { %><li class="comment" data-id="<%= comment.id %>"><p class="comment-meta"><strong><%= comment.authorName || 'Guest' %></strong> · <time datetime="<%= new Date(comment.createdAt).toISOString() %>"><%= new Date(comment.createdAt).toLocaleString('en-US') %></time></p><p class="comment-body"><%= comment.body %></p></li><% }) %></ul></section></main><footer class="site-footer"><strong>THE DAILY BUGLE</strong><span>Serving New York City — facts, rumors, and everything in between.</span></footer><script>window.ARTICLE_CONFIG={commentsApi:'/api/articles/<%= article.id %>/comments',logoutApi:'/api/auth/logout',locale:'en-US',timeZone:'America/New_York'};</script><script src="/js/article.js" defer></script></body></html>