<!doctype html>
<html lang="en">
  
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title><%= title %> — The Daily Bugle</title>
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="stylesheet" href="/css/newsroom.css" />
  </head>

  <body>
    <header class="compact-header">
      <nav class="account-bar" aria-label="Account">
        <a class="nav-link" href="/editor">← Editor desk</a>
        <span>Signed in as <strong><%= currentUser.name %></strong> · editor</span>
        <button id="logout" class="light-button" type="button">Log out</button>
      </nav>
      <p class="eyebrow">THE DAILY BUGLE · EDITOR</p>
      <h1 style="text-align: center;"><%= draft.title %></h1>
      
      <p style="text-align: center;">
        Status: <span class="level level-<%= article.status %>"><%= article.status %></span>
        · By <%= article.reporterName %>
      </p>
      
      <div class="header-actions" style="display: flex; justify-content: center; gap: 1rem; border-top: 1px solid #eaeaea; padding-top: 1.2rem; margin-top: 1.2rem; margin-bottom: 1rem;">
        <a href="/editor/<%= article._id || article.id %>/edit" class="btn btn-small" style="font-size: 0.85rem; padding: 0.4rem 1rem; background: #eee; text-decoration: none; border-radius: 4px; color: #333; font-weight: 500;">Edit this article</a>
        
        <a href="/editor/<%= article._id || article.id %>/analytics" class="btn btn-small" style="font-size: 0.85rem; padding: 0.4rem 1rem; background: #eee; text-decoration: none; border-radius: 4px; color: #333; font-weight: 500;">View analytics</a>
        
        <% if (article.isLive) { %> 
          <a href="/articles/<%= article._id || article.id %>" class="btn btn-small" target="_blank" style="font-size: 0.85rem; padding: 0.4rem 1rem; background: #eee; text-decoration: none; border-radius: 4px; color: #333; font-weight: 500;">View live page</a>
        <% } %>
      </div>
    </header>

    <main class="admin-main">
      <section class="panel">
        <h2>Submitted content (pending review)</h2>
        <p><strong>Category:</strong> <%= draft.category %></p>
        <p><strong>Summary:</strong> <%= draft.summary %></p>
        <p><%= draft.content %></p>

        <% if (notice) { %><p class="workflow-notice" role="status"><%= notice %></p><% } %>
        
        <% if (article.status === 'pending') { %>
          <form class="review-actions" method="post" action="/editor/<%= article._id || article.id %>/review">
            <div class="card-actions">
              <button type="submit" name="decision" value="approve">Approve &amp; publish</button>
              <button type="submit" name="decision" value="return" class="secondary">Return for fixes</button>
            </div>
            <label class="wide">Note to the reporter (required when returning)
              <textarea name="editorNote" rows="3" maxlength="1000"></textarea>
            </label>
          </form>
        <% } %>
        
        <% if (!article.isLive) { %>
          <form method="post" action="/editor/<%= article._id || article.id %>/delete" onsubmit="return confirm('Delete this unpublished article permanently?')">
            <button type="submit" class="secondary">Delete unpublished article</button>
          </form>
        <% } %>
        <p id="review-message" class="form-message" role="status"></p>
      </section>

      <section class="panel">
        <h2>Currently live on the site</h2>
        <% if (live) { %>
          <p><strong>Published:</strong> <%= new Date(live.publishedAt).toLocaleString() %></p>
          <p><strong>Category:</strong> <%= live.category %></p>
          <p><strong>Summary:</strong> <%= live.summary %></p>
          <p><%= live.content %></p>
        <% } else { %>
          <div class="empty-state">This article has never been published — nothing is live yet.</div>
        <% } %>
      </section>
    </main>
    
    <script src="/js/reporter-dashboard.js" defer></script>
  </body>
</html>