<%# הצהרת HTML5 %>
<!doctype html>
<%# אלמנט השורש %>
<html lang="en">
  <%# ראש המסמך %>
  <head>
    <%# קידוד UTF-8 %>
    <meta charset="UTF-8" />
    <%# viewport לרספונסיביות %>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <%# כותרת הלשונית %>
    <title><%= title %> — The Daily Bugle</title>
    <%# קובץ העיצוב %>
    <link rel="stylesheet" href="/css/styles.css" />
    <link rel="stylesheet" href="/css/newsroom.css" />
  <%# סוף הראש %>
  </head>
  <%# גוף הדף %>
  <body>
    <%# כותרת עליונה קומפקטית %>
    <header class="compact-header">
      <%# סרגל חשבון %>
      <nav class="account-bar" aria-label="Account">
        <%# חזרה לעמוד הבדיקה של הכתבה הספציפית %>
        <a class="nav-link" href="/editor/<%= articleId %>">← Back to review</a>
        <%# שם המשתמש %>
        <span>Signed in as <strong><%= currentUser.name %></strong> · editor</span>
        <%# כפתור יציאה %>
        <button id="logout" class="light-button" type="button">Log out</button>
      <%# סוף הסרגל %>
      </nav>
      <%# כיתוב קטן %>
      <p class="eyebrow">THE DAILY BUGLE · ANALYTICS IMPACT</p>
      <%# כותרת - שם הכתבה %>
      <h1><%= articleTitle %></h1>
      <%# הסבר קצר על הגרף %>
      <p>Daily recorded reader views for the last 30 days.</p>
    <%# סוף הכותרת העליונה %>
    </header>
    <%# תוכן ראשי %>
    <main class="form-main">
      <%# פאנל הגרף %>
      <section class="analytics-summary" aria-label="Article view summary">
        <div><span>All-time views</span><strong><%= totalViews %></strong></div>
        <div><span>Last 30 days</span><strong><%= periodViews %></strong></div>
      </section>
      <section class="panel analytics-panel" aria-labelledby="analytics-chart-title">
        <div class="analytics-heading"><div><p class="eyebrow">LAST 30 DAYS</p><h2 id="analytics-chart-title">Daily reader views</h2></div><span>UTC</span></div>
        <% if (periodViews === 0) { %><p class="empty-state">No recorded views in the last 30 days.</p><% } %>
        <div class="analytics-chart" role="img" aria-label="Daily views over the last 30 days">
          <% dailyViews.forEach((day) => { %>
            <div class="analytics-day" title="<%= day.date %>: <%= day.views %> views">
              <span class="analytics-value"><%= day.views || '' %></span>
              <span class="analytics-bar" style="--bar-height: <%= Math.max(3, Math.round(day.views / peakViews * 100)) %>%"></span>
              <span class="analytics-date"><%= day.label %></span>
            </div>
          <% }) %>
        </div>
      <%# סוף הפאנל %>
      </section>
    <%# סוף התוכן הראשי %>
    </main>
    <script src="/js/reporter-dashboard.js" defer></script>
  <%# סוף הגוף %>
  </body>
<%# סוף המסמך %>
</html>
