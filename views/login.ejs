<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %> — The Daily Bugle</title><link rel="stylesheet" href="/css/styles.css"><link rel="stylesheet" href="/css/auth.css"></head><body class="auth-page"><header class="auth-brand"><a class="wordmark" href="/">THE DAILY <span>BUGLE</span></a><p>NEW YORK'S MOST UNRELIABLE SOURCE</p></header><main class="auth-main"><section class="auth-panel"><a class="back-link" href="/">← Back to headlines</a><p class="auth-kicker">THE NEWSROOM</p><h1>Sign in</h1><p class="auth-intro">Log in to write, edit, or approve stories for the Daily Bugle.</p><form id="login-form" class="auth-form"><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" required><label for="password">Password</label><div class="password-field"><input id="password" name="password" type="password" autocomplete="current-password" required><button id="toggle-password" class="password-toggle" type="button" aria-label="Show password">Show</button></div><button id="submit" class="btn auth-submit" type="submit">Log in</button><p id="form-message" class="form-message" role="status" aria-live="polite"></p></form><div class="auth-links"><a href="/register/reporter">Create reporter account</a><a href="/register/editor">Create editor account</a></div></section></main><script>window.AUTH_CONFIG={loginApi:'/api/auth/login',registerApi:'/api/auth/register',roleHome:{reporter:'/reporter',editor:'/editor'}};</script><script src="/js/auth.js" defer></script></body></html>