<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %> — The Daily Bugle</title><link rel="stylesheet" href="/css/styles.css"><link rel="stylesheet" href="/css/auth.css"></head><body class="auth-page"><header class="auth-brand"><a class="wordmark" href="/">THE DAILY <span>BUGLE</span></a><p>NEW YORK'S MOST UNRELIABLE SOURCE</p></header><main class="auth-main"><section class="auth-panel"><a class="back-link" href="/">← Back to headlines</a><p class="auth-kicker">JOIN THE NEWSROOM</p><h1>Create <%= role %> account</h1><p class="auth-intro"><%= role === 'editor' ? 'Editors review and approve stories. An editor registration code is required.' : 'Create an account to draft stories and submit them for editorial review.' %></p><form id="register-form" class="auth-form" data-role="<%= role %>"><label for="name">Full name</label><input id="name" name="name" maxlength="100" autocomplete="name" required><label for="email">Email</label><input id="email" name="email" type="email" autocomplete="email" required><label for="password">Password</label><input id="password" name="password" type="password" minlength="8" autocomplete="new-password" required><% if (role === 'editor') { %><label for="editorCode">Editor registration code</label><input id="editorCode" name="editorCode" type="password" autocomplete="off" required><% } %><button id="submit" class="btn auth-submit" type="submit">Create account</button><p id="form-message" class="form-message" role="status" aria-live="polite"></p></form><div class="auth-links"><a href="/login">Already have an account? Log in</a></div></section></main><script>window.AUTH_CONFIG={loginApi:'/api/auth/login',registerApi:'/api/auth/register',roleHome:{reporter:'/reporter',editor:'/editor'}};</script><script src="/js/auth.js" defer></script></body></html>