# Copy this file to .env and fill in real values. .env itself is gitignored --
# never commit real secrets.

# MongoDB connection string, e.g. mongodb://127.0.0.1:27017/the-daily-web
# or a mongodb+srv://... Atlas URI.
MONGODB_URI=mongodb://127.0.0.1:27017/the-daily-web

# Any long random string. Used to sign login sessions (JWT). Changing this
# logs everyone out.
JWT_SECRET=replace-with-a-long-random-string

PORT=3000
NODE_ENV=development

# Seeds demo users/articles/views/comments on startup if the database is empty.
# Set to false against a database that should stay empty.
SEED_DEMO_DATA=true

# Also append every log line to logs/application.log (in addition to MongoDB).
LOG_TO_FILE=false

# Shared code required to self-register as an editor at /register/editor.
# Leave blank to disable editor self-registration entirely.
EDITOR_SIGNUP_CODE=

# OpenWeatherMap (or a similar free provider with no credit card required).
WEATHER_API_KEY=your-api-key-here
WEATHER_CITY=Tel Aviv,IL
